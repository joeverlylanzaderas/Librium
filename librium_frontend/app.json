{
  "expo": {
    "name": "Librium",
    "slug": "librium",
    "scheme": "librium",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#0f1117",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1117"
      },
      "package": "com.jvrly.css.librium",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "librium"
            },
            {
              "scheme": "https",
              "host": "librium-web.netlify.app",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "librium.onrender.com",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
